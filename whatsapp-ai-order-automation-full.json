{
  "name": "WhatsApp AI Order Automation - Full",
  "nodes": [
    {
      "parameters": {
        "content": "## Setup\n1. Open the **Config** node and set `backendBaseUrl` to your deployed CRM backend's public URL (no trailing slash), and `whatsappVerifyToken` to a value you also enter in Meta's WhatsApp webhook config.\n2. Create an **HTTP Header Auth** credential named `Automation API Secret` — Header Name = `X-Automation-Secret`, Value = the same string as `AUTOMATION_API_SECRET` in the backend's `.env`. Attach it to every node calling `/api/automation/*`.\n3. Create/select an **OpenAI** credential on the `AI Generate Response` node.\n4. (Optional) Create an **HTTP Header Auth** credential named `Brevo API` — Header Name = `api-key`, Value = your `BREVO_API_KEY` — for order-notification emails.\n5. Activate the workflow, copy the production webhook URL, and paste it into Meta's WhatsApp App → Configuration → Webhook.\n\nOne deployment of this workflow serves every business on the platform — it resolves the right business per incoming message by WhatsApp `phone_number_id`, which each business enters in CRM Settings → WhatsApp Integration.",
        "height": 420,
        "width": 460
      },
      "id": "note1",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, -40]
    },
    {
      "parameters": {
        "httpMethod": ["GET", "POST"],
        "path": "whatsapp-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1",
      "name": "WhatsApp Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 420],
      "webhookId": "whatsapp-incoming"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-base-url",
              "name": "backendBaseUrl",
              "value": "https://YOUR-BACKEND-URL",
              "type": "string"
            },
            {
              "id": "cfg-verify-token",
              "name": "whatsappVerifyToken",
              "value": "YOUR_WHATSAPP_VERIFY_TOKEN",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "cfg",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 420]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "m1",
              "leftValue": "={{ $json.headers.method || $json.method }}",
              "rightValue": "GET",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "2",
      "name": "IF Meta Verification",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 420]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "vt1",
              "leftValue": "={{ $json.query['hub.verify_token'] }}",
              "rightValue": "={{ $node['Config'].json.whatsappVerifyToken }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "2b",
      "name": "IF Verify Token Valid",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 260]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}",
        "options": { "responseCode": 200 }
      },
      "id": "3",
      "name": "Respond Verification Challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [880, 180]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "Forbidden",
        "options": { "responseCode": 403 }
      },
      "id": "3b",
      "name": "Respond Verification Failed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [880, 340]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst entry = body?.entry?.[0];\nconst change = entry?.changes?.[0]?.value;\nconst message = change?.messages?.[0];\nconst phoneNumberId = change?.metadata?.phone_number_id;\nconst from = message?.from;\nconst messageId = message?.id || '';\nconst type = message?.type || 'text';\nconst isMedia = type !== 'text';\nconst rawText = type === 'text' ? (message?.text?.body || '') : '';\n\nif (!message) {\n  return [{ json: { skip: true } }];\n}\n\nreturn [{\n  json: {\n    phoneNumberId,\n    from,\n    text: isMedia ? `[Customer sent a ${type} message - please reply manually in the CRM]` : rawText,\n    isMedia,\n    messageId,\n    skip: false,\n  },\n}];"
      },
      "id": "4",
      "name": "Parse Incoming Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 480]
    },
    {
      "parameters": { "respondWith": "noData", "options": {} },
      "id": "5",
      "name": "Ack Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [880, 480]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "s1",
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "6",
      "name": "IF Valid Message",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 480]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $node['Config'].json.backendBaseUrl }}/api/automation/dedupe",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"messageId\": $json.messageId } }}",
        "options": { "timeout": 10000 }
      },
      "id": "7",
      "name": "Dedupe Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 480],
      "onError": "continueRegularOutput",
      "credentials": { "httpHeaderAuth": { "id": "3", "name": "Automation API Secret" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "d1",
              "leftValue": "={{ $json.alreadyProcessed }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "notEquals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "8",
      "name": "IF Not Already Processed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1540, 480]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $node['Config'].json.backendBaseUrl }}/api/automation/business-by-phone/{{ $node['Parse Incoming Message'].json.phoneNumberId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 10000 }
      },
      "id": "10",
      "name": "Business Lookup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, 400],
      "onError": "continueRegularOutput",
      "credentials": { "httpHeaderAuth": { "id": "3", "name": "Automation API Secret" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cl1",
              "leftValue": "={{ $json.business?.id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "11",
      "name": "IF Business Found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1980, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $node['Config'].json.backendBaseUrl }}/api/automation/customers/find-or-create",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"businessId\": $node['Business Lookup'].json.business.id, \"phoneNumber\": $node['Parse Incoming Message'].json.from } }}",
        "options": { "timeout": 10000 }
      },
      "id": "cust1",
      "name": "Find or Create Customer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2200, 320],
      "onError": "continueRegularOutput",
      "credentials": { "httpHeaderAuth": { "id": "3", "name": "Automation API Secret" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $node['Config'].json.backendBaseUrl }}/api/automation/conversations/find-or-create",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"businessId\": $node['Business Lookup'].json.business.id, \"customerId\": $json.customer.id } }}",
        "options": { "timeout": 10000 }
      },
      "id": "conv1",
      "name": "Find or Create Conversation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2420, 320],
      "onError": "continueRegularOutput",
      "credentials": { "httpHeaderAuth": { "id": "3", "name": "Automation API Secret" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $node['Config'].json.backendBaseUrl }}/api/automation/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"conversationId\": $json.conversation.id, \"senderType\": \"customer\", \"content\": $node['Parse Incoming Message'].json.text } }}",
        "options": { "timeout": 10000 }
      },
      "id": "msg1",
      "name": "Save Inbound Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2640, 320],
      "onError": "continueRegularOutput",
      "credentials": { "httpHeaderAuth": { "id": "3", "name": "Automation API Secret" } }
    },
    {
      "parameters": {
        "jsCode": "const conversation = $node['Find or Create Conversation'].json.conversation;\nconst business = $node['Business Lookup'].json.business;\nconst parsed = $node['Parse Incoming Message'].json;\n\nconst shouldReply = conversation?.mode === 'auto' && business?.aiAutoReplyEnabled === true && !parsed.isMedia;\n\nreturn [{ json: { shouldReply } }];"
      },
      "id": "sar1",
      "name": "Should AI Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2860, 320]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "sar2",
              "leftValue": "={{ $json.shouldReply }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "sar3",
      "name": "IF Should AI Reply",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [3080, 320]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $node['Config'].json.backendBaseUrl }}/api/automation/products",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [{ "name": "businessId", "value": "={{ $node['Business Lookup'].json.business.id }}" }]
        },
        "options": { "timeout": 10000 }
      },
      "id": "12",
      "name": "Get Products",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3300, 220],
      "onError": "continueRegularOutput",
      "credentials": { "httpHeaderAuth": { "id": "3", "name": "Automation API Secret" } }
    },
    {
      "parameters": {
        "modelId": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "=You are a sales assistant for {{ $node['Business Lookup'].json.business.name }}. {{ $node['Business Lookup'].json.business.aiInstructions ? $node['Business Lookup'].json.business.aiInstructions : 'Be polite, helpful, and accurate.' }} Available products (JSON, source of truth - never invent products or prices not in this list): {{ JSON.stringify($node['Get Products'].json.products) }}. Recent conversation history: {{ JSON.stringify($node['Find or Create Conversation'].json.conversation.recentMessages) }}. Reply ONLY with valid JSON, no extra text, in this exact shape: {\"reply\": \"<message to send the customer>\", \"order_confirmed\": false, \"order\": {\"items\": [{\"productName\": \"\", \"qty\": 0, \"price\": 0}], \"total\": 0, \"deliveryAddress\": \"\", \"city\": \"\"}}. Set order_confirmed to true only once the customer has explicitly confirmed a final order including what they want to buy."
            },
            {
              "role": "user",
              "content": "={{ $node['Parse Incoming Message'].json.text }}"
            }
          ]
        },
        "options": { "responseFormat": "json_object" }
      },
      "id": "15",
      "name": "AI Generate Response",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [3520, 220],
      "credentials": { "openAiApi": { "id": "2", "name": "OpenAI Account" } }
    },
    {
      "parameters": {
        "jsCode": "let parsed;\ntry {\n  parsed = JSON.parse($input.first().json.message.content);\n} catch (e) {\n  parsed = { reply: \"Sorry, I couldn't process that. Could you rephrase?\", order_confirmed: false, order: null };\n}\nreturn [{ json: parsed }];"
      },
      "id": "16",
      "name": "Parse AI JSON Safely",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3740, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $node['Config'].json.backendBaseUrl }}/api/automation/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"conversationId\": $node['Find or Create Conversation'].json.conversation.id, \"senderType\": \"ai\", \"content\": $json.reply } }}",
        "options": { "timeout": 10000 }
      },
      "id": "17",
      "name": "Save AI Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3960, 220],
      "onError": "continueRegularOutput",
      "credentials": { "httpHeaderAuth": { "id": "3", "name": "Automation API Secret" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $node['Parse Incoming Message'].json.phoneNumberId }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $node['Business Lookup'].json.business.whatsappAccessToken }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"messaging_product\": \"whatsapp\", \"to\": $node['Parse Incoming Message'].json.from, \"text\": { \"body\": $node['Parse AI JSON Safely'].json.reply } } }}",
        "options": { "timeout": 10000 }
      },
      "id": "18",
      "name": "Send WhatsApp Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [4180, 220],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [

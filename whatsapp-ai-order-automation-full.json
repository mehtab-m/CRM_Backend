              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "19",
      "name": "IF Order Confirmed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [4400, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $node['Config'].json.backendBaseUrl }}/api/automation/orders",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"businessId\": $node['Business Lookup'].json.business.id, \"customerId\": $node['Find or Create Customer'].json.customer.id, \"items\": $node['Parse AI JSON Safely'].json.order.items, \"deliveryAddress\": $node['Parse AI JSON Safely'].json.order.deliveryAddress, \"city\": $node['Parse AI JSON Safely'].json.order.city } }}",
        "options": { "timeout": 10000 }
      },
      "id": "20",
      "name": "Create Order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [4620, 140],
      "onError": "continueRegularOutput",
      "credentials": { "httpHeaderAuth": { "id": "3", "name": "Automation API Secret" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "ne1",
              "leftValue": "={{ $node['Business Lookup'].json.business.notifyEmail }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "ne2",
      "name": "IF Has Notify Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [4840, 140]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.brevo.com/v3/smtp/email",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"sender\": { \"email\": \"orders@yourdomain.com\", \"name\": $node['Business Lookup'].json.business.name }, \"to\": [ { \"email\": $node['Business Lookup'].json.business.notifyEmail } ], \"subject\": \"New WhatsApp order - \" + $node['Business Lookup'].json.business.name, \"htmlContent\": \"<p>New order from \" + $node['Parse Incoming Message'].json.from + \"</p><p>Items: \" + JSON.stringify($node['Parse AI JSON Safely'].json.order.items) + \"</p><p>Total: \" + $node['Parse AI JSON Safely'].json.order.total + \"</p>\" } }}",
        "options": { "timeout": 10000 }
      },
      "id": "21",
      "name": "Email Order Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [5060, 140],
      "onError": "continueRegularOutput",
      "credentials": { "httpHeaderAuth": { "id": "5", "name": "Brevo API" } }
    }
  ],
  "connections": {
